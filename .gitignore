# NOTE: gitignore does NOT support trailing inline comments — `#` only starts a
# comment at the beginning of a line. Keep comments on their own line, or the
# text becomes part of the pattern and the rule silently matches nothing.

# ---- competition data -------------------------------------------------------
# The RMUC dataset belongs to DJI RoboMaster, and the archive exceeds GitHub's
# 100 MB per-file limit. Download it from the official forum post linked in the
# README and place it here. Only the field-description doc is tracked.
/dataset/*
!/dataset/*.md

# ---- generated artefacts ----------------------------------------------------
# Leading slash matters: a bare `data/` would also match the SOURCE package
# rm_rl/data/ and silently drop half the codebase from the repo.
/data/
/runs/
/rm_runs/
*.npz
*.pt
*.ckpt
*.sqlite
*.sqlite3
*.db

# ---- third-party arena image ------------------------------------------------
# From the RMUC 2026 rulebook — DJI's material, not ours to redistribute.
# viz/assets/README.md says where to get it; every tool degrades to a plain
# grid without it.  The README beside it stays tracked.
/viz/assets/*
!/viz/assets/README.md

# ---- visualisation output ---------------------------------------------------
# An exported replay is a machine-readable re-encoding of one match's full
# per-second referee state — i.e. a slice of DJI's dataset — so it is generated
# locally and never committed.  The aggregate figures under viz/figures/ ARE
# tracked: they are derived statistics, and the README renders them.
/viz/replays/
/viz/figures/*.mp4
/viz/figures/*.gif
/viz/figures/*.webm

# ---- local-only working copies ----------------------------------------------
# arena_ref/ is a private reference copy of the Arena-1 tournament kit
# (organiser's AGENT_GUIDE / sdk.py / arena.json). Third-party material, and
# not part of this framework — keep it local.
/arena_ref/
# integrations/ holds a git WORKTREE of the separate radar27 repository
# (.git is a file pointing at ../radar27/.git/worktrees/...). It cannot be
# committed as a plain directory; it is versioned in its own repo. Restore with
#   git -C ../radar27 worktree add ../RMUC-OfflineRL-main/integrations/radar27-radio-replay <branch>
/integrations/

# ---- archives ---------------------------------------------------------------
*.7z
*.zip
*.tar
*.tar.gz
*.tgz
*.bundle

# ---- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.ipynb_checkpoints/

# ---- tooling / os -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# ---- secrets ----------------------------------------------------------------
# jev_demo/ keeps its TypeSafe API key in .env; its own .gitignore covers it,
# this is the repo-wide backstop.
.env
*.key
